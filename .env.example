# Chronicle local settings. Copy to .env, which git ignores:  cp .env.example .env
# (make setup does this for you). A value already exported in your shell wins
# over this file. Leave a value blank to use the default.

# Anthropic API key. Only `make eval-live` needs it; make test, eval and demo run offline.
ANTHROPIC_API_KEY=

# Demo server (`make demo`) on localhost: http://127.0.0.1:8000
# Use 0.0.0.0 only if you mean to expose it to your network.
CHRONICLE_HOST=127.0.0.1
CHRONICLE_PORT=8000
